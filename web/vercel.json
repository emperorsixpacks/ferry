{
  "rewrites": [
    {
      "source": "/daemon/z/:path*",
      "destination": "https://YOUR_COOLIFY_DOMAIN/daemon/z/:path*"
    },
    {
      "source": "/daemon/b/:path*",
      "destination": "https://YOUR_COOLIFY_DOMAIN/daemon/b/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ]
}
