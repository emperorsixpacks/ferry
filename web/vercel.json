{
  "rewrites": [
    {
      "source": "/daemon/:role",
      "destination": "/api/daemon-proxy?role=:role"
    },
    {
      "source": "/api/:path*",
      "destination": "http://vaqaxhvocuvf1rnukimkfvql.161.35.55.45.sslip.io/api/:path*"
    },
    {
      "source": "/router/:path*",
      "destination": "http://vaqaxhvocuvf1rnukimkfvql.161.35.55.45.sslip.io/router/:path*"
    },
    {
      "source": "/:path((?!api|daemon|assets|vite|index|favicon).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/daemon-proxy.ts": {
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000" }
      ]
    }
  ]
}
