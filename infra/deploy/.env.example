# Copy to infra/deploy/.env (deploy.sh does this on first run and fills in the secrets).

# Public hostname; DNS A/AAAA must point at the server before the first start (Caddy gets TLS).
DOMAIN=ferry.example.com

# bitcoind's rpcauth line (user "ferry", salted hash of secrets/btc_rpc_pass). deploy.sh
# generates both on the server; the password itself is never in this file. API tokens live in
# the daemons' token volumes (see docs/DEPLOY.md, "Rotating secrets").
BTC_RPCAUTH=

# Zcash testnet lightwalletd (TLS for remote hosts).
ZEC_SERVER=testnet.zec.rocks:443

# Maker (B, "bram") offer: sat per ZEC and the swap size range in zatoshi.
RATE=410000
MIN_ZAT=10000000
MAX_ZAT=100000000
# Follow the market instead of RATE: kraken, coingecko, all, or off. The rate is the median of the
# sources that answer, times (1 + SPREAD_BPS/10000); the offer pauses if every source fails for
# 5 minutes. MIN_ZAT/MAX_ZAT still apply. Off by default: at the real price (~1.4M sat per ZEC) the
# maker needs about 3x more signet BTC than at the fixed demo RATE.
PRICE_FEED=off
SPREAD_BPS=50
# The maker list on /app: name|url|pair|chain, comma-separated. Empty = the maker above, plus the
# maker of each enabled pair (COMPOSE_PROFILES below). Set it only to list other makers; then
# include the enabled pairs' makers yourself (docs/DEPLOY.md, "More pairs").
FERRY_MAKERS=
# How many swaps each daemon runs at once, as maker and taker together (ferryd --max-swaps, 1 to
# 64), every pair. Empty: ferryd's default, 4 on these test networks. A daemon also takes only
# as many as its free funds cover; past either, a start is refused as busy.
MAX_SWAPS=

# Swap terms, in signet blocks (about 10 min each); see `infra/testnet.sh help` for the reasoning.
T1=6
T2=6
DELTA=2
BTC_LOCK_CONFS=1
ZEC_CONFS=3
CANCEL_CONFS=1
FEE_SAT=1500
POLL_MS=5000

# bitcoind: pruned block storage (MB) and its cache (MB; lower it on a small host).
PRUNE_MB=2000
DBCACHE_MB=1000

# Public UI guard (web/server/prod.mjs): largest swap a visitor may start (zatoshi), swap starts
# per client IP per hour and across all visitors per hour, and whether the inspector's stall
# buttons work.
DEMO_MAX_ZAT=50000000
DEMO_RATE_PER_HOUR=3
DEMO_SWAPS_PER_HOUR=12
# Open live-update streams (/api/events) per client IP and in total.
DEMO_SSE_PER_IP=8
DEMO_SSE_TOTAL=200
DEMO_FAULTS=0

# ------------------------------------------------------------------ more pairs
# docs/DEPLOY.md, "More pairs". Which optional pairs run, comma-separated (or use
# `deploy.sh <ssh-host> enable <pair>`): ltc (ZEC/LTC on Litecoin testnet), usdc-base (ZEC/USDC
# on Base Sepolia), weth-base (ZEC/WETH on Base Sepolia). Empty: ZEC/BTC only. Each pair has its
# own maker (B) and taker (Z); the demo guard above applies to all of them, and each maker's
# MIN/MAX below narrows it per pair. infra/deploy/compose gives the web server the enabled pairs
# and, while FERRY_MAKERS above is empty, a maker list with each of their makers.
COMPOSE_PROFILES=
# Visitors sell ZEC on every pair. BUY_ZEC names the pairs where they may also buy it
# (comma-separated: btc, ltc, usdc-base, weth-base; an optional pair must also be in
# COMPOSE_PROFILES). B then starts the swap and the pair's Z, the operator's own, is the maker that
# sells ZEC; both are this server's wallets, as for a sell. Empty: selling only (docs/DEPLOY.md,
# "Buying ZEC").
BUY_ZEC=

# ZEC/LTC (profile ltc). litecoind's rpcauth line (user "ferry", salted hash of
# secrets/ltc_rpc_pass); `infra/deploy/ctl secrets` (run by deploy.sh) generates both.
LTC_RPCAUTH=
# Maker offer: litoshi per ZEC and the swap size range in zatoshi. A fixed demo rate, far below
# the market (about 19 LTC per ZEC in October 2026) so faucet coins last: 1 LTC per ZEC, swaps of
# 0.01 to 0.25 ZEC. LTC_PRICE_FEED (kraken, coingecko, all, off) follows ZEC/LTC instead.
LTC_RATE=100000000
LTC_MIN_ZAT=1000000
LTC_MAX_ZAT=25000000
LTC_PRICE_FEED=off
LTC_SPREAD_BPS=50
# Swap terms in Litecoin blocks (about 2.5 min): the same wall-clock windows as ZEC/BTC on signet.
# ferryd's Litecoin testnet policy asks for DELTA >= 8 and 2 lock/cancel confirmations.
LTC_T1=24
LTC_T2=24
LTC_DELTA=8
LTC_LOCK_CONFS=2
LTC_CANCEL_CONFS=2
# Fixed fee of each presigned Litecoin transaction (litoshi; about 10 lit/vB).
LTC_FEE_LIT=2000
# litecoind: pruned block storage (MB) and its cache (MB).
LTC_PRUNE_MB=2000
LTC_DBCACHE_MB=300

# Base Sepolia (profiles usdc-base, weth-base). The JSON-RPC both pairs' daemons use. The public
# https://sepolia.base.org is rate limited and shared; use a provider's Base Sepolia endpoint, e.g.
# https://base-sepolia.g.alchemy.com/v2/<key>. The URL is on the daemons' command lines, so use a
# key that only serves this.
BASE_SEPOLIA_RPC=https://sepolia.base.org
# Deadlines in seconds of Base block time, as infra/evm-testnet.sh (docs/EVM.md, "Timing on a
# public chain"): t1 45 min after the proposal, refund window 30 min, margins 5 min, 10 lock
# confirmations (about 20 s), eth_getLogs in 200-block chunks, a poll every 4 s.
EVM_T1_SECS=2700
EVM_REFUND_SECS=1800
EVM_DELTA_SECS=300
EVM_LOCK_CONFS=10
EVM_LOG_CHUNK=200
EVM_POLL_MS=4000

# ZEC/USDC (profile usdc-base): USDC base units (10^-6) per ZEC. 40 USDC per ZEC (a demo rate;
# the faucet gives a few USDC at a time), swaps of 0.01 to 0.25 ZEC (0.40 to 10 USDC).
# USDC_PRICE_FEED follows ZEC/USDC instead.
USDC_RATE=40000000
USDC_MIN_ZAT=1000000
USDC_MAX_ZAT=25000000
USDC_PRICE_FEED=off
USDC_SPREAD_BPS=50

# ZEC/WETH (profile weth-base): wei per ZEC. 0.012 WETH per ZEC (a demo rate), swaps of 0.01 to
# 0.25 ZEC (0.00012 to 0.003 WETH). WETH_PRICE_FEED follows ZEC/ETH instead.
WETH_RATE=12000000000000000
WETH_MIN_ZAT=1000000
WETH_MAX_ZAT=25000000
WETH_PRICE_FEED=off
WETH_SPREAD_BPS=50
