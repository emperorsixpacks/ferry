# Copy to infra/deploy/.env (deploy.sh does this on first run and fills in the secrets).

# Public hostname; DNS A/AAAA must point at the server before the first start (Caddy gets TLS).
DOMAIN=ferry.example.com

# bitcoind's rpcauth line (user "ferry", salted hash of secrets/btc_rpc_pass). deploy.sh
# generates both on the server; the password itself is never in this file. API tokens live in
# the daemons' token volumes (see docs/DEPLOY.md, "Rotating secrets").
BTC_RPCAUTH=

# Zcash testnet lightwalletd (TLS for remote hosts).
ZEC_SERVER=testnet.zec.rocks:443

# Maker (B, "bram") offer: sat per ZEC and the swap size range in zatoshi.
RATE=410000
MIN_ZAT=10000000
MAX_ZAT=100000000

# Swap terms, in signet blocks (about 10 min each); see `infra/testnet.sh help` for the reasoning.
T1=6
T2=6
DELTA=2
BTC_LOCK_CONFS=1
ZEC_CONFS=3
CANCEL_CONFS=1
FEE_SAT=1500
POLL_MS=5000

# bitcoind: pruned block storage (MB) and its cache (MB; lower it on a small host).
PRUNE_MB=2000
DBCACHE_MB=1000

# Public UI guard (web/server/prod.mjs): largest swap a visitor may start (zatoshi), swap starts
# per client IP per hour and across all visitors per hour, and whether the inspector's stall
# buttons work.
DEMO_MAX_ZAT=50000000
DEMO_RATE_PER_HOUR=3
DEMO_SWAPS_PER_HOUR=12
# Open live-update streams (/api/events) per client IP and in total.
DEMO_SSE_PER_IP=8
DEMO_SSE_TOTAL=200
DEMO_FAULTS=0
