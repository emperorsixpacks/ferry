# Ferry env for VERCEL (the UI + the /api/daemon proxy). Set in the Vercel dashboard under
# Project Settings > Environment Variables.

# Coolify exposes these two daemon control APIs on port 7101 (z) and 7102 (b).
FERRY_Z_URL=http://qilxpthaltlgc2ler5avzdbt.161.35.55.45.sslip.io:7101
FERRY_B_URL=http://tyiwzwy4m66dhl9xkcxultfj.161.35.55.45.sslip.io:7102

# Daemon API tokens (same values as in Coolify).
FERRY_Z_TOKEN=d881ba9a02d91cf5ed858ce38cce21619d6828f218e0a064171a3e072f1f8871
FERRY_B_TOKEN=afbcccb16ea4661fdd6ad18fb4067fb6236469631a45a2da9f85cdab82a6b4d6

# How Z's daemon reaches B's peer port — reachable FROM ferryd-z, so internal to Coolify.
FERRY_MAKER_URL=http://ferryd-b:7112

# The Vercel domain. Used to check the Origin header on POSTs.
PUBLIC_ORIGIN=https://ferryzec.vercel.app

# Which role the swap app at / belongs to (z or b).
FERRY_LOCAL=z
