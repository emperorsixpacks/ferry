# TLS for the public demo (certificates from Let's Encrypt, kept in the caddy_data volume).
{$DOMAIN} {
	# Compress everything but the SSE swap updates: a compressed event stream waits in the encoder
	# until enough has piled up, so a quiet daemon's updates never reach the page.
	@compress not header Accept *text/event-stream*
	encode @compress zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# The UI streams swap updates over SSE: never buffer.
	reverse_proxy web:8080 {
		flush_interval -1
	}
}
