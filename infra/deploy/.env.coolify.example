# Ferry env for Coolify — paste these into Coolify's "Environment Variables" for the service.
# Coolify handles TLS; PUBLIC_ORIGIN must match the domain you set in Coolify.

# Required secrets — generate with: openssl rand -hex 32
BTC_RPC_PASS=
FERRY_Z_TOKEN=
FERRY_B_TOKEN=

# The domain the BROWSER sees — your Vercel domain (e.g. https://ferry.vercel.app or your custom domain).
# This is the Origin the prod server checks on POSTs.
PUBLIC_ORIGIN=https://ferry.vercel.app

# The domain Coolify exposes the `web` proxy service on. The Vercel frontend calls this
# for /daemon/{z,b}/*. Set this in Coolify's domain settings for the web service.
# Example: https://ferry-web.your-coolify.app
WEB_PROXY_URL=https://ferry-web.your-coolify.app

# Optional overrides (defaults are fine for most cases)
BTC_RPC_USER=ferry
ZEC_SERVER=testnet.zec.rocks:443
RATE=410000
MIN_ZAT=10000000
MAX_ZAT=100000000
T1=6
T2=6
DELTA=2
BTC_LOCK_CONFS=1
ZEC_CONFS=3
CANCEL_CONFS=1
FEE_SAT=1500
POLL_MS=5000
PRUNE_MB=2000
DBCACHE_MB=1000
B_PEER_PUBLISH=127.0.0.1:7112
B_PUBLIC_PEER_URL=http://ferryd-b:7112
DEMO_MAX_ZAT=50000000
DEMO_RATE_PER_HOUR=3
DEMO_FAULTS=0
